        "files": {
          "extension.js": "function handle(request) {\n  if (typeof request.method === 'string' && request.method.indexOf('lifecycle.') === 0) return {result:{}};\n  if (request.method !== 'aggregate_sales') throw new Error('Unknown method: ' + request.method);\n  var p = request.params;\n  if (!p || !Array.isArray(p.rows) || !Array.isArray(p.issues)) throw new Error('rows and issues must be arrays');\n  if (p.issues.length) throw new Error('Sales extraction requires correction: ' + p.issues.join('; '));\n  var scale = 2;\n  var rows = p.rows.map(function(row, index) {\n    if (!row || typeof row.customer !== 'string' || !row.customer.trim()) throw new Error('Missing customer at row ' + (index + 1));\n    if (typeof row.amount !== 'string' || row.amount.length > 120 || !/^[+-]?[0-9]+(?:\\.[0-9]+)?$/.test(row.amount)) throw new Error('Invalid amount at row ' + (index + 1));\n    var s = row.amount;\n    var negative = s.charAt(0) === '-';\n    if (s.charAt(0) === '-' || s.charAt(0) === '+') s = s.slice(1);\n    var parts = s.split('.');\n    var fraction = parts[1] || '';\n    scale = Math.max(scale, fraction.length);\n    return {customer:row.customer.trim(), whole:parts[0], fraction:fraction, negative:negative};\n  });\n  var sums = new Map();\n  var total = BigInt(0);\n  rows.forEach(function(row) {\n    var digits = row.whole + row.fraction + '0'.repeat(scale - row.fraction.length);\n    var value = BigInt(digits);\n    if (row.negative) value = -value;\n    sums.set(row.customer, (sums.has(row.customer) ? sums.get(row.customer) : BigInt(0)) + value);\n    total += value;\n  });\n  function format(value) {\n    var negative = value < BigInt(0);\n    var digits = (negative ? -value : value).toString();\n    if (digits.length <= scale) digits = '0'.repeat(scale + 1 - digits.length) + digits;\n    return (negative ? '-' : '') + digits.slice(0, digits.length - scale) + '.' + digits.slice(digits.length - scale);\n  }\n  var entries = Array.from(sums.entries());\n  entries.sort(function(a,b) {\n    if (a[1] !== b[1]) return a[1] > b[1] ? -1 : 1;\n    return a[0] < b[0] ? -1 : (a[0] > b[0] ? 1 : 0);\n  });\n  var highest = entries.length ? entries[0][1] : null;\n  return {result:{\n    row_count:rows.length,\n    customer_count:entries.length,\n    totals:entries.map(function(e){return {customer:e[0],amount:format(e[1])};}),\n    highest_customers:entries.filter(function(e){return e[1] === highest;}).map(function(e){return e[0];}),\n    highest_amount:highest === null ? null : format(highest),\n    total_amount:format(total)\n  }};\n}\n"

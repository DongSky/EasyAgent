{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "name": {
      "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,100}$",
      "title": "Name",
      "type": "string"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "input_schema": {
      "additionalProperties": true,
      "title": "Input Schema",
      "type": "object"
    },
    "output_schema": {
      "additionalProperties": true,
      "title": "Output Schema",
      "type": "object"
    },
    "effect": {
      "default": "read",
      "enum": [
        "read",
        "write",
        "local"
      ],
      "title": "Effect",
      "type": "string"
    },
    "idempotent": {
      "default": true,
      "title": "Idempotent",
      "type": "boolean"
    },
    "execution_mode": {
      "default": "auto",
      "enum": [
        "auto",
        "sequential",
        "parallel"
      ],
      "title": "Execution Mode",
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "title": "ToolSpec",
  "type": "object"
}

  "properties": {
    "kind": {
      "enum": [
        "memory",
        "context",
        "terminal",
        "browser",
        "approval",
        "channel",
        "media"
      ],
      "title": "Kind",
      "type": "string"
    },
    "handler": {
      "title": "Handler",
      "type": "string"
    },
    "operations": {
      "items": {
        "type": "string"
      },

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ExtensionError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 1000,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ExtensionError",
      "type": "object"
    },
    "ExtensionServiceCall": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "input": {
          "additionalProperties": true,
          "title": "Input",
          "type": "object"
        }
      },
      "required": [
        "name",
        "input"
      ],
      "title": "ExtensionServiceCall",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "result": {
      "default": null,
      "title": "Result"
    },
    "state": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "State"
    },
    "calls": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/ExtensionServiceCall"
          },
          "maxItems": 16,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Calls"
    },
    "continue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Continue"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExtensionError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "title": "ExtensionResponse",
  "type": "object"
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Step": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "default": "tool",
          "enum": [
            "goal",
            "tool",
            "model",
            "agent",
            "transform",
            "retrieve",
            "artifact",
            "foreach",
            "subworkflow",
            "approval",
            "input"
          ],
          "title": "Kind",
          "type": "string"
        },
        "target": {
          "default": "",
          "title": "Target",
          "type": "string"
        },
        "tool_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Revision"
        },
        "input": {
          "additionalProperties": true,
          "title": "Input",
          "type": "object"
        },
        "depends_on": {
          "items": {
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "max_attempts": {
          "default": 3,
          "maximum": 10,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 60,
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "not_before": {
          "default": 0,
          "minimum": 0,
          "title": "Not Before",
          "type": "number"
        },
        "requires_approval": {
          "default": false,
          "title": "Requires Approval",
          "type": "boolean"
        },
        "when": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "When"
        },
        "body": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Body"
        },
        "workflow_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkflowReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "compensate": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Compensate"
        }
      },
      "required": [
        "id"
      ],
      "title": "Step",
      "type": "object"
    },
    "WorkflowReference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 101,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        }
      },
      "required": [
        "id"
      ],
      "title": "WorkflowReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A public input contract and exactly one executable Step template.",
  "properties": {
    "step": {
      "$ref": "#/$defs/Step"
    },
    "input_schema": {
      "additionalProperties": true,
      "title": "Input Schema",
      "type": "object"
    },
    "output_schema": {
      "additionalProperties": true,
      "title": "Output Schema",
      "type": "object"
    },
    "defaults": {
      "additionalProperties": true,
      "title": "Defaults",
      "type": "object"
    }
  },
  "required": [
    "step"
  ],
  "title": "NodeDefinition",
  "type": "object"
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "RunLimits": {
      "additionalProperties": false,
      "properties": {
        "model_calls": {
          "default": 64,
          "maximum": 10000,
          "minimum": 0,
          "title": "Model Calls",
          "type": "integer"
        },
        "tool_calls": {
          "default": 256,
          "maximum": 10000,
          "minimum": 0,
          "title": "Tool Calls",
          "type": "integer"
        },
        "output_tokens": {
          "default": 131072,
          "maximum": 10000000,
          "minimum": 1,
          "title": "Output Tokens",
          "type": "integer"
        },
        "cost_usd": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        },
        "child_runs": {
          "default": 256,
          "maximum": 4096,
          "minimum": 0,
          "title": "Child Runs",
          "type": "integer"
        },
        "wall_time_seconds": {
          "default": 604800,
          "exclusiveMinimum": 0,
          "maximum": 31536000,
          "title": "Wall Time Seconds",
          "type": "number"
        }
      },
      "title": "RunLimits",
      "type": "object"
    },
    "Step": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "default": "tool",
          "enum": [
            "goal",
            "tool",
            "model",
            "agent",
            "transform",
            "retrieve",
            "artifact",
            "foreach",
            "subworkflow",
            "approval",
            "input"
          ],
          "title": "Kind",
          "type": "string"
        },
        "target": {
          "default": "",
          "title": "Target",
          "type": "string"
        },
        "tool_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Revision"
        },
        "input": {
          "additionalProperties": true,
          "title": "Input",
          "type": "object"
        },
        "depends_on": {
          "items": {
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "max_attempts": {
          "default": 3,
          "maximum": 10,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 60,
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "not_before": {
          "default": 0,
          "minimum": 0,
          "title": "Not Before",
          "type": "number"
        },
        "requires_approval": {
          "default": false,
          "title": "Requires Approval",
          "type": "boolean"
        },
        "when": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "When"
        },
        "body": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Body"
        },
        "workflow_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkflowReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "compensate": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Compensate"
        }
      },
      "required": [
        "id"
      ],
      "title": "Step",
      "type": "object"
    },
    "WorkflowReference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 101,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        }
      },
      "required": [
        "id"
      ],
      "title": "WorkflowReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "name": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/Step"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Steps",
      "type": "array"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "inputs": {
      "additionalProperties": true,
      "title": "Inputs",
      "type": "object"
    },
    "limits": {
      "$ref": "#/$defs/RunLimits"
    }
  },
  "required": [
    "name",
    "steps"
  ],
  "title": "Workflow",
  "type": "object"
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ToolSpec": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,100}$",
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "input_schema": {
          "additionalProperties": true,
          "title": "Input Schema",
          "type": "object"
        },
        "output_schema": {
          "additionalProperties": true,
          "title": "Output Schema",
          "type": "object"
        },
        "effect": {
          "default": "read",
          "enum": [
            "read",
            "write",
            "local"
          ],
          "title": "Effect",
          "type": "string"
        },
        "idempotent": {
          "default": true,
          "title": "Idempotent",
          "type": "boolean"
        },
        "execution_mode": {
          "default": "auto",
          "enum": [
            "auto",
            "sequential",
            "parallel"
          ],
          "title": "Execution Mode",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "ToolSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "model": {
      "title": "Model",
      "type": "string"
    },
    "capability": {
      "default": "chat",
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
      "title": "Capability",
      "type": "string"
    },
    "messages": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Messages",
      "type": "array"
    },
    "tools": {
      "items": {
        "$ref": "#/$defs/ToolSpec"
      },
      "title": "Tools",
      "type": "array"
    },
    "response_schema": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Response Schema"
    },
    "prompt": {
      "default": "",
      "title": "Prompt",
      "type": "string"
    },
    "context": {
      "default": null,
      "title": "Context"
    },
    "parameters": {
      "additionalProperties": true,
      "title": "Parameters",
      "type": "object"
    },
    "attachments": {
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "title": "Attachments",
      "type": "array"
    },
    "max_output_tokens": {
      "default": 2048,
      "maximum": 262144,
      "minimum": 1,
      "title": "Max Output Tokens",
      "type": "integer"
    }
  },
  "required": [
    "model"
  ],
  "title": "ModelRequest",
  "type": "object"
}

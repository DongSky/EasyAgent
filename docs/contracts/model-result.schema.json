{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ToolCall": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "arguments": {
          "additionalProperties": true,
          "title": "Arguments",
          "type": "object"
        },
        "argument_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Argument Error"
        },
        "raw_arguments": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Arguments"
        }
      },
      "required": [
        "id",
        "name",
        "arguments"
      ],
      "title": "ToolCall",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "text": {
      "default": "",
      "title": "Text",
      "type": "string"
    },
    "data": {
      "default": null,
      "title": "Data"
    },
    "tool_calls": {
      "items": {
        "$ref": "#/$defs/ToolCall"
      },
      "title": "Tool Calls",
      "type": "array"
    },
    "images": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Images",
      "type": "array"
    },
    "embeddings": {
      "items": {
        "items": {
          "type": "number"
        },
        "type": "array"
      },
      "title": "Embeddings",
      "type": "array"
    },
    "usage": {
      "additionalProperties": true,
      "title": "Usage",
      "type": "object"
    },
    "provider_state": {
      "additionalProperties": true,
      "title": "Provider State",
      "type": "object"
    }
  },
  "title": "ModelResult",
  "type": "object"
}

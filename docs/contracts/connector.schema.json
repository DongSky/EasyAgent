{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^[a-z][a-z0-9_]{1,40}$",
      "title": "Id",
      "type": "string"
    },
    "title": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "kind": {
      "enum": [
        "system",
        "webhook",
        "telegram",
        "caldav",
        "slack",
        "discord",
        "feishu"
      ],
      "title": "Kind",
      "type": "string"
    },
    "url": {
      "default": "",
      "title": "Url",
      "type": "string"
    },
    "device_id": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Device Id"
    },
    "credential": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Credential"
    },
    "authorization_prefix": {
      "default": "Bearer ",
      "title": "Authorization Prefix",
      "type": "string"
    },
    "recipient": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Recipient"
    },
    "idempotent": {
      "default": false,
      "title": "Idempotent",
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "title",
    "kind"
  ],
  "title": "Connector",
  "type": "object"
}
